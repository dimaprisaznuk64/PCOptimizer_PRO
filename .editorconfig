root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,pyi}]
indent_style = space
indent_size = 4

[*.{md,json,jsonc,yml,yaml,toml}]
indent_style = space
indent_size = 2

[*.{ps1,iss,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
